<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8D5F4"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/babyImageMain"
        android:layout_width="368dp"
        android:layout_height="171dp"
        android:layout_marginBottom="40dp"
        android:background="#F8D5F4"
        android:backgroundTint="#F8D5F4"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/PregnancyWeek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="Bieżący tydzień ciąży: 12"
        android:textAlignment="center"
        android:textColor="#0D0D0D"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCalendar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#DA54ED"
        android:text="Calendar"
        app:iconTint="#3C95AB" />

    <Button
        android:id="@+id/btnInfo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#DA54ED"
        android:text="Baby's development" />

    <Button
        android:id="@+id/btnNotes"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#DA54ED"
        android:text="Notes and symptoms" />

    <Button
        android:id="@+id/btnReport"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#DA54ED"
        android:text="Generuj Raport" />



</LinearLayout>